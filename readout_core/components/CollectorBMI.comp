/*******************************************************************************
*
* McStas readout-master component for the ESS data pipeline
*
* %I
* Written by: Gregory Tucker
* Date: 2026
* Origin: European Spallation Source ERIC
*
* Collect BMI (integrating beam-monitor) readout records into an HDF5 file
* for post-run replay to an Event Formation Unit.
*
* %D
* Stores one weighted-ray record per traced neutron into a named collector
* group of a cue-based HDF5 file. The record layout matches the canonical
* BMI readout for integrating beam monitors: ring, FEN, time-of-flight,
* weight, channel, sum, and a 32-bit ADC value. Files are merged with
* `readout-combine` and sent to an EFU with `readout-replay`.
*
* Identifying values are read *by name* from particle variables (typically
* USER_VARS set in an EXTEND block). `ring` must name a resolvable variable;
* `channel_name`, `sum_name`, `adc_name` and `fen` fall back to their
* `*_value` counterparts when left unset.
*
* Example: COMPONENT collect = CollectorBMI(
*     ring="ring_id", adc_name="mon_adc", filename="run", dataset_name="bmi")
*   AT (0, 0, 0) RELATIVE PREVIOUS
*
* %P
* INPUT PARAMETERS:
*
* ring: [str]       name of the particle variable holding the fibre ID; required. The EFU
*                   reads fibres 2N and 2N+1 as its ring N, so for a cbm EFU configured with
*                   "MonitorRing": N this must hold 2N or 2N+1
* fen: [str]        name of the particle variable holding the Front End Node ID; empty uses fen_value
* channel_name: [str] name of the particle variable holding the monitor channel; empty uses channel_value
* sum_name: [str]   name of the particle variable holding the sum field; empty uses sum_value
* adc_name: [str]   name of the particle variable holding the integrated ADC value; empty uses adc_value
* tof: [str]        name of the particle variable holding the time-of-flight; "t" reads the ray time
* ring_count: [1]   currently unused; reserved
* fen_count: [1]    currently unused; reserved
* fen_value: [1]    fixed FEN ID used when fen is not named
* channel_value: [1] fixed channel used when channel_name is not named
* sum_value: [1]    fixed sum used when sum_name is not named
* adc_value: [1]    fixed ADC value used when adc_name is not named
* keep_probability: [1] probability of recording each ray; a recorded ray stores its weight divided
*                   by it, so the expected total weight is unchanged. Below 1 it records fewer rays
*                   at the cost of statistical noise: a monitor sees far more rays than its histogram needs
* efficiency: [1]   detection efficiency, multiplying every recorded weight: it scales the monitored
*                   intensity without changing how many rays are recorded
* pulse_rate: [Hz]  currently unused by the collector; reference times are reconstructed at replay
* filename: [str]   HDF5 output file; empty stores to "collected_events"; several collectors may share one file
* dataset_name: [str] collector group name inside the file; empty uses the component instance name
* verbose: [1]      -1: silent, 0: errors, 1: warnings, 2: info, 3: details
* ess_type: [1]     library DetectorType stored with the group (replay sends CBM0, CBM1,
*                   CBM2 and CBMI in packets of the EFU's CBM type, 0x10); 0xfa (CBMI) is the only type
*                   that maps to the BMI readout layout
* efu_address: [str] optional EFU address stored as a group attribute for replay routing
* efu_port: [1]     optional EFU UDP port stored as a group attribute for replay routing
* sink: [str]      where records are stored: "auto" (default) uses the McStas NeXus output file
*                  when the simulation runs with --format=NeXus and the collector HDF5 file otherwise;
*                  "nexus" or "hdf5" force one of them
*
* %L
* The <a href="https://github.com/ess-dmsc/event-formation-unit">Event Formation Unit</a>
* and the ESS Detector Interface Control Documents describe the beam-monitor readout formats.
*
* %E
*******************************************************************************/

DEFINE COMPONENT CollectorBMI
DEFINITION PARAMETERS()
SETTING PARAMETERS (
string ring = 0,
string fen = 0,
string channel_name = 0,
string sum_name = 0,
string adc_name = 0,
string tof = "t",
int ring_count=1,
int fen_count=1,
int fen_value=0,
int channel_value=0,
int sum_value=0,
int adc_value=0,
keep_probability = 1,
efficiency = 1,
pulse_rate = 14,
string filename = 0,
string dataset_name = 0,
int verbose=0, // -1: silent, 0: errors, 1: warnings, 2: info, 3: details
int ess_type=250, // 0xfa == 250: CBMI, the only DetectorType that maps to ReadoutType::BMI
string efu_address = 0, // Optional EFU IP address for replay routing; leave 0/empty to omit from file
int efu_port = 0,        // Optional EFU UDP port for replay routing; leave 0 to omit from file
string sink = "auto"     // Where records go: "auto" (NeXus output file with --format=NeXus, else HDF5 file), "nexus" or "hdf5"
)
OUTPUT PARAMETERS ()
DEPENDENCY "CMD(readout-config --show buildflags)"
SHARE
%{
%include "lib-readout"

/* One stored record, laid out to match the canonical BMI description from
 * readout_description_for(ess_type): uint8 ring, uint8 FEN, double time, double weight,
 * uint8 channel, uint8 sum, uint32 adc.  Member names are prefixed to avoid clashing
 * with particle, component, or instrument parameter names. */
struct collector_bmi_record {
    uint8_t  rec_ring;
    uint8_t  rec_fen;
    double   rec_time;
    double   rec_weight;
    uint8_t  rec_channel;
    uint8_t  rec_sum;
    uint32_t rec_adc;
};
%}

DECLARE
%{
array_t * array_ptr;
readout_sink_t * sink_ptr;
double ncount_total;

int fen_present;
int channel_present;
int sum_present;
int adc_present;

char * this_filename;
char * this_dataset_name;
%}

INITIALIZE
%{
if (!(keep_probability > 0 && keep_probability <= 1) || !(efficiency >= 0 && efficiency <= 1)) {
  char value[64];
  snprintf(value, sizeof(value), "keep_probability=%g, efficiency=%g", keep_probability, efficiency);
  lib_readout_error("CollectorBMI", NAME_CURRENT_COMP,
                    "keep_probability must be in (0, 1] and efficiency in [0, 1]; got", value);
}
char * basepath = mcfull_file("", NULL);

this_filename = NULL;
char * safe_filename = NULL;
if (filename == NULL || filename[0] == '\0') {
  safe_filename = (char *) calloc(17, sizeof(char));
  strcpy(safe_filename, "collected_events");
} else {
  safe_filename = (char *) calloc(strlen(filename)+1, sizeof(char));
  strcpy(safe_filename, filename);
}
this_filename = (char *) calloc(collector_construct_filename_size(basepath, safe_filename), sizeof(char));
collector_construct_filename(basepath, safe_filename, this_filename);
free(safe_filename);
if (basepath) free(basepath);

int have_dataset_name = (dataset_name != NULL) && (dataset_name[0] != '\0');
this_dataset_name = (char *) calloc(strlen(have_dataset_name ? dataset_name : NAME_CURRENT_COMP)+1, sizeof(char));
strcpy(this_dataset_name, have_dataset_name ? dataset_name : NAME_CURRENT_COMP);

fen_present     = ((fen          != NULL) && (fen[0]          != '\0')) ? 1 : 0;
channel_present = ((channel_name != NULL) && (channel_name[0] != '\0')) ? 1 : 0;
sum_present     = ((sum_name     != NULL) && (sum_name[0]     != '\0')) ? 1 : 0;
adc_present     = ((adc_name     != NULL) && (adc_name[0]     != '\0')) ? 1 : 0;

int failure=0;
particle_getvar(_particle, ring, &failure); if (failure) collector_error(NAME_CURRENT_COMP, ring);
if (fen_present){
    particle_getvar(_particle, fen, &failure); if (failure) collector_error(NAME_CURRENT_COMP, fen);
}
if (channel_present){
    particle_getvar(_particle, channel_name, &failure); if (failure) collector_error(NAME_CURRENT_COMP, channel_name);
}
if (sum_present){
    particle_getvar(_particle, sum_name, &failure); if (failure) collector_error(NAME_CURRENT_COMP, sum_name);
}
if (adc_present){
    particle_getvar(_particle, adc_name, &failure); if (failure) collector_error(NAME_CURRENT_COMP, adc_name);
}
particle_getvar(_particle, tof, &failure); if (failure) collector_error(NAME_CURRENT_COMP, tof);

if (this_filename == NULL || this_filename[0] == '\0') {
  collector_error(NAME_CURRENT_COMP, "Filename is empty after processing, cannot create Collector instance.");
}

const char * record_description = readout_description_for(ess_type);
if (record_description == NULL) {
  collector_error(NAME_CURRENT_COMP, "No canonical record description for the given ess_type.");
}

// INITIALIZE runs before the rays are split over MPI nodes: this is the total number of rays,
// the one sources normalise p to. weight = p * ncount_total, normalization = ncount_total.
ncount_total = (double) mcget_ncount();

sink_ptr = readout_sink_new(sink, this_filename, this_dataset_name,
  record_description, ess_type, (uint64_t) ncount_total, sizeof(struct collector_bmi_record),
  efu_address, efu_port, NAME_CURRENT_COMP, INDEX_CURRENT_COMP, POS_A_CURRENT_COMP, ROT_A_CURRENT_COMP, verbose);

array_ptr = new_array(sizeof(struct collector_bmi_record));

%}

TRACE
%{
double weight = p * ncount_total * efficiency;
// Record a ray with probability keep_probability, and store its weight divided by that
// probability so the expected total is unchanged. No draw at the default of 1, so a run
// that does not thin uses the random-number stream exactly as before.
if (weight && keep_probability < 1) {
  weight = (rand01() < keep_probability) ? weight / keep_probability : 0;
}

if (weight) {
    struct collector_bmi_record data = {
        .rec_ring    = (uint8_t) (readout_particle_getvar_int(_particle, ring)),
        .rec_fen     = (uint8_t) (fen_present     ? readout_particle_getvar_int(_particle, fen)         : fen_value),
        .rec_time    = particle_getvar(_particle, tof, 0),
        .rec_weight  = weight,
        .rec_channel = (uint8_t) (channel_present ? readout_particle_getvar_int(_particle, channel_name): channel_value),
        .rec_sum     = (uint8_t) (sum_present     ? readout_particle_getvar_int(_particle, sum_name)    : sum_value),
        .rec_adc     = (uint32_t)(adc_present     ? readout_particle_getvar_int(_particle, adc_name)    : adc_value)
    };
    if (verbose > 2)
      printf("(%2u %2u) ch=%2u sum=%2u adc=%8u %0.10f -- Collected\n",
             data.rec_ring, data.rec_fen, data.rec_channel, data.rec_sum, data.rec_adc, data.rec_time);

    array_add(array_ptr, (const void *)(&data));
}

%}

SAVE
%{
// all MPI nodes: gather the records on the master, which stores them (HDF5 file or NeXus output)
readout_sink_save(sink_ptr, array_ptr);
%}


FINALLY
%{
if (array_size(array_ptr) != 0) {
  fprintf(stderr, "Warning: array still has %zu elements at FINALLY block of %s\n", array_size(array_ptr), NAME_CURRENT_COMP);
}

// closes the collector (HDF5 sink) on the master node
readout_sink_free(sink_ptr);
sink_ptr = NULL;

delete_array(array_ptr);
array_ptr = NULL;
free(this_filename);
free(this_dataset_name);
%}

MCDISPLAY
%{
%}

END
