/*******************************************************************************
*
* McStas readout-master component for the ESS data pipeline
*
* %I
* Written by: Gregory Tucker
* Date: 2026
* Origin: European Spallation Source ERIC
*
* Collect VMM3 (Micromegas/strip-detector ASIC) readout records into an HDF5
* file for post-run replay to an Event Formation Unit.
*
* %D
* Stores one weighted-ray record per traced neutron into a named collector
* group of a cue-based HDF5 file. The record layout matches the canonical
* VMM3 readout used by strip- and Micromegas-based instruments: ring, FEN,
* time-of-flight, weight, bunch-crossing counter (BC), over-threshold flag
* and ADC (OTADC), geometry ID (GEO), time-to-digital value (TDC), VMM ASIC
* ID, and channel. Files are merged with `readout-combine` and sent to an
* EFU with `readout-replay`.
*
* Identifying values are read *by name* from particle variables (typically
* USER_VARS set in an EXTEND block). `ring` must name a resolvable variable;
* all other identifying fields fall back to their `*_value` counterparts
* when left unset.
*
* Example: COMPONENT collect = CollectorVMM3(
*     ring="ring_id", vmm_name="vmm", channel_name="strip",
*     otadc_name="amplitude", filename="run", dataset_name="nmx_plane0",
*     ess_type=0x44)
*   AT (0, 0, 0) RELATIVE PREVIOUS
*
* %P
* INPUT PARAMETERS:
*
* ring: [str]       name of the particle variable holding the Ring (fibre) ID; required
* fen: [str]        name of the particle variable holding the Front End Node ID; empty uses fen_value
* bc_name: [str]    name of the particle variable holding the bunch-crossing counter; empty uses bc_value
* otadc_name: [str] name of the particle variable holding the over-threshold ADC; empty uses otadc_value
* geo_name: [str]   name of the particle variable holding the geometry ID; empty uses geo_value
* tdc_name: [str]   name of the particle variable holding the TDC value; empty uses tdc_value
* vmm_name: [str]   name of the particle variable holding the VMM ASIC ID; empty uses vmm_value
* channel_name: [str] name of the particle variable holding the channel; empty uses channel_value
* tof: [str]        name of the particle variable holding the time-of-flight; "t" reads the ray time
* ring_count: [1]   currently unused; reserved
* fen_count: [1]    currently unused; reserved
* fen_value: [1]    fixed FEN ID used when fen is not named
* bc_value: [1]     fixed bunch-crossing counter used when bc_name is not named
* otadc_value: [1]  fixed over-threshold ADC used when otadc_name is not named
* geo_value: [1]    fixed geometry ID used when geo_name is not named
* tdc_value: [1]    fixed TDC value used when tdc_name is not named
* vmm_value: [1]    fixed VMM ASIC ID used when vmm_name is not named
* channel_value: [1] fixed channel used when channel_name is not named
* pulse_rate: [Hz]  currently unused by the collector; reference times are reconstructed at replay
* filename: [str]   HDF5 output file; empty stores to "collected_events"; several collectors may share one file
* dataset_name: [str] collector group name inside the file; empty uses the component instance name
* verbose: [1]      -1: silent, 0: errors, 1: warnings, 2: info, 3: details
* ess_type: [1]     ESS DetectorType byte stored with the group; 0x40 (TREX) maps to the VMM3
*                   readout layout, as do NMX (0x44), FREIA (0x48), TBLVMM (0x49), and ESTIA (0x4c)
* efu_address: [str] optional EFU address stored as a group attribute for replay routing
* efu_port: [1]     optional EFU UDP port stored as a group attribute for replay routing
* sink: [str]      where records are stored: "auto" (default) uses the McStas NeXus output file
*                  when the simulation runs with --format=NeXus and the collector HDF5 file otherwise;
*                  "nexus" or "hdf5" force one of them
*
* %L
* The <a href="https://github.com/ess-dmsc/event-formation-unit">Event Formation Unit</a>
* and the ESS Detector Interface Control Documents describe the VMM3 readout format.
*
* %E
*******************************************************************************/

DEFINE COMPONENT CollectorVMM3
DEFINITION PARAMETERS()
SETTING PARAMETERS (
string ring = 0,
string fen = 0,
string bc_name = 0,
string otadc_name = 0,
string geo_name = 0,
string tdc_name = 0,
string vmm_name = 0,
string channel_name = 0,
string tof = "t",
int ring_count=1,
int fen_count=1,
int fen_value=0,
int bc_value=0,
int otadc_value=0,
int geo_value=0,
int tdc_value=0,
int vmm_value=0,
int channel_value=0,
pulse_rate = 14,
string filename = 0,
string dataset_name = 0,
int verbose=0, // -1: silent, 0: errors, 1: warnings, 2: info, 3: details
int ess_type=64, // 0x40 == 64: TREX, which maps to ReadoutType::VMM3 (also NMX=0x44, FREIA=0x48, TBLVMM=0x49, ESTIA=0x4c)
string efu_address = 0, // Optional EFU IP address for replay routing; leave 0/empty to omit from file
int efu_port = 0,        // Optional EFU UDP port for replay routing; leave 0 to omit from file
string sink = "auto"     // Where records go: "auto" (NeXus output file with --format=NeXus, else HDF5 file), "nexus" or "hdf5"
)
OUTPUT PARAMETERS ()
DEPENDENCY "CMD(readout-config --show buildflags)"
SHARE
%{
%include "lib-readout"

/* One stored record, laid out to match the canonical VMM3 description from
 * readout_description_for(ess_type): uint8 ring, uint8 FEN, double time, double weight,
 * uint16 bc, uint16 otadc, uint8 geo, uint8 tdc, uint8 vmm, uint8 channel.
 * Member names are prefixed to avoid clashing with particle, component, or instrument
 * parameter names. */
struct collector_vmm3_record {
    uint8_t  rec_ring;
    uint8_t  rec_fen;
    double   rec_time;
    double   rec_weight;
    uint16_t rec_bc;
    uint16_t rec_otadc;
    uint8_t  rec_geo;
    uint8_t  rec_tdc;
    uint8_t  rec_vmm;
    uint8_t  rec_channel;
};
%}

DECLARE
%{
array_t * array_ptr;
readout_sink_t * sink_ptr;
double ncount_total;

int fen_present;
int bc_present;
int otadc_present;
int geo_present;
int tdc_present;
int vmm_present;
int channel_present;

char * this_filename;
char * this_dataset_name;
%}

INITIALIZE
%{
char * basepath = mcfull_file("", NULL);

this_filename = NULL;
char * safe_filename = NULL;
if (filename == NULL || filename[0] == '\0') {
  safe_filename = (char *) calloc(17, sizeof(char));
  strcpy(safe_filename, "collected_events");
} else {
  safe_filename = (char *) calloc(strlen(filename)+1, sizeof(char));
  strcpy(safe_filename, filename);
}
this_filename = (char *) calloc(collector_construct_filename_size(basepath, safe_filename), sizeof(char));
collector_construct_filename(basepath, safe_filename, this_filename);
free(safe_filename);
if (basepath) free(basepath);

int have_dataset_name = (dataset_name != NULL) && (dataset_name[0] != '\0');
this_dataset_name = (char *) calloc(strlen(have_dataset_name ? dataset_name : NAME_CURRENT_COMP)+1, sizeof(char));
strcpy(this_dataset_name, have_dataset_name ? dataset_name : NAME_CURRENT_COMP);

fen_present     = ((fen          != NULL) && (fen[0]          != '\0')) ? 1 : 0;
bc_present      = ((bc_name      != NULL) && (bc_name[0]      != '\0')) ? 1 : 0;
otadc_present   = ((otadc_name   != NULL) && (otadc_name[0]   != '\0')) ? 1 : 0;
geo_present     = ((geo_name     != NULL) && (geo_name[0]     != '\0')) ? 1 : 0;
tdc_present     = ((tdc_name     != NULL) && (tdc_name[0]     != '\0')) ? 1 : 0;
vmm_present     = ((vmm_name     != NULL) && (vmm_name[0]     != '\0')) ? 1 : 0;
channel_present = ((channel_name != NULL) && (channel_name[0] != '\0')) ? 1 : 0;

int failure=0;
particle_getvar(_particle, ring, &failure); if (failure) collector_error(NAME_CURRENT_COMP, ring);
if (fen_present){
    particle_getvar(_particle, fen, &failure); if (failure) collector_error(NAME_CURRENT_COMP, fen);
}
if (bc_present){
    particle_getvar(_particle, bc_name, &failure); if (failure) collector_error(NAME_CURRENT_COMP, bc_name);
}
if (otadc_present){
    particle_getvar(_particle, otadc_name, &failure); if (failure) collector_error(NAME_CURRENT_COMP, otadc_name);
}
if (geo_present){
    particle_getvar(_particle, geo_name, &failure); if (failure) collector_error(NAME_CURRENT_COMP, geo_name);
}
if (tdc_present){
    particle_getvar(_particle, tdc_name, &failure); if (failure) collector_error(NAME_CURRENT_COMP, tdc_name);
}
if (vmm_present){
    particle_getvar(_particle, vmm_name, &failure); if (failure) collector_error(NAME_CURRENT_COMP, vmm_name);
}
if (channel_present){
    particle_getvar(_particle, channel_name, &failure); if (failure) collector_error(NAME_CURRENT_COMP, channel_name);
}
particle_getvar(_particle, tof, &failure); if (failure) collector_error(NAME_CURRENT_COMP, tof);

if (this_filename == NULL || this_filename[0] == '\0') {
  collector_error(NAME_CURRENT_COMP, "Filename is empty after processing, cannot create Collector instance.");
}

const char * record_description = readout_description_for(ess_type);
if (record_description == NULL) {
  collector_error(NAME_CURRENT_COMP, "No canonical record description for the given ess_type.");
}

// INITIALIZE runs before the rays are split over MPI nodes: this is the total number of rays,
// the one sources normalise p to. weight = p * ncount_total, normalization = ncount_total.
ncount_total = (double) mcget_ncount();

sink_ptr = readout_sink_new(sink, this_filename, this_dataset_name,
  record_description, ess_type, (uint64_t) ncount_total, sizeof(struct collector_vmm3_record),
  efu_address, efu_port, NAME_CURRENT_COMP, INDEX_CURRENT_COMP, POS_A_CURRENT_COMP, ROT_A_CURRENT_COMP, verbose);

array_ptr = new_array(sizeof(struct collector_vmm3_record));

%}

TRACE
%{
double weight = p * ncount_total;

if (weight) {
    struct collector_vmm3_record data = {
        .rec_ring    = (uint8_t) (readout_particle_getvar_int(_particle, ring)),
        .rec_fen     = (uint8_t) (fen_present     ? readout_particle_getvar_int(_particle, fen)         : fen_value),
        .rec_time    = particle_getvar(_particle, tof, 0),
        .rec_weight  = weight,
        .rec_bc      = (uint16_t)(bc_present      ? readout_particle_getvar_int(_particle, bc_name)     : bc_value),
        .rec_otadc   = (uint16_t)(otadc_present   ? readout_particle_getvar_int(_particle, otadc_name)  : otadc_value),
        .rec_geo     = (uint8_t) (geo_present     ? readout_particle_getvar_int(_particle, geo_name)    : geo_value),
        .rec_tdc     = (uint8_t) (tdc_present     ? readout_particle_getvar_int(_particle, tdc_name)    : tdc_value),
        .rec_vmm     = (uint8_t) (vmm_present     ? readout_particle_getvar_int(_particle, vmm_name)    : vmm_value),
        .rec_channel = (uint8_t) (channel_present ? readout_particle_getvar_int(_particle, channel_name): channel_value)
    };
    if (verbose > 2)
      printf("(%2u %2u) bc=%5u otadc=%5u geo=%2u tdc=%2u vmm=%2u ch=%2u %0.10f -- Collected\n",
             data.rec_ring, data.rec_fen, data.rec_bc, data.rec_otadc,
             data.rec_geo, data.rec_tdc, data.rec_vmm, data.rec_channel, data.rec_time);

    array_add(array_ptr, (const void *)(&data));
}

%}

SAVE
%{
// all MPI nodes: gather the records on the master, which stores them (HDF5 file or NeXus output)
readout_sink_save(sink_ptr, array_ptr);
%}


FINALLY
%{
if (array_size(array_ptr) != 0) {
  fprintf(stderr, "Warning: array still has %zu elements at FINALLY block of %s\n", array_size(array_ptr), NAME_CURRENT_COMP);
}

// closes the collector (HDF5 sink) on the master node
readout_sink_free(sink_ptr);
sink_ptr = NULL;

delete_array(array_ptr);
array_ptr = NULL;
free(this_filename);
free(this_dataset_name);
%}

MCDISPLAY
%{
%}

END
